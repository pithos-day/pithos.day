# R2 同期 (scripts/r2-sync.ts) 用の認証情報
#
# このファイルはサンプルです。実際の値は .env に書き、.env は git 管理外にしてください。
# CI (Workers Builds) では同名の変数をシークレットとして設定します。
#
# 値の入手元:
# - R2_ACCOUNT_ID / R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY
#   Cloudflare ダッシュボード > R2 > API トークン
#   (ローカル用は Object Read & Write、CI 用は Object Read Only で分けるのが望ましい)
# - バケット名は R2 > バケット から

R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key

# 既定値あり。変更した場合のみ設定する
R2_IMG_BUCKET=pithos-day-img
R2_BLOG_BUCKET=pithos-day-blog

# CI (Workers Builds) でのみ設定する変数 (ローカルの .env には書かないこと):
# pull で「ローカルにファイルが在るディレクトリ」の取得を省略する。
# ビルドコマンド先頭の pnpm sync:pull と prebuild の pull が二重になるのを防ぐ。
# R2_SYNC_IF_MISSING=1
